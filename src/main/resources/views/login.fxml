<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.railway.controller.LoginController"
      alignment="CENTER" spacing="20" styleClass="app-root">
    <padding>
        <Insets top="35" right="35" bottom="35" left="35"/>
    </padding>

    <!-- Header Section -->
    <VBox alignment="CENTER" spacing="6">
        <HBox alignment="CENTER" spacing="10">
            <Label text="🚆" style="-fx-font-size: 32px;"/>
            <Label text="INDIAN RAILWAYS RESERVATION PORTAL" styleClass="header-title"/>
        </HBox>
        <Label text="IRCTC RailPlan — Concurrent, Rule-Driven Ticket Booking &amp; Fleet Management" styleClass="header-subtitle"/>
    </VBox>

    <!-- Main Auth Card Container -->
    <VBox maxWidth="520" styleClass="card-panel" spacing="18">
        <padding>
            <Insets top="25" right="30" bottom="25" left="30"/>
        </padding>

        <TabPane tabClosingPolicy="UNAVAILABLE">
            <!-- TAB 1: LOGIN -->
            <Tab text="  Sign In  ">
                <VBox spacing="14">
                    <padding>
                        <Insets top="16" right="8" bottom="8" left="8"/>
                    </padding>
                    <VBox spacing="5">
                        <Label text="Username:"/>
                        <TextField fx:id="usernameField" promptText="Enter passenger1 or admin" text="passenger1"/>
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Password:"/>
                        <PasswordField fx:id="passwordField" promptText="Enter your password" text="pass123"/>
                    </VBox>
                    <Label fx:id="statusLabel" wrapText="true" style="-fx-font-weight: bold;"/>
                    <Button fx:id="loginButton" text="Authenticate &amp; Enter Portal" onAction="#handleLogin"
                            maxWidth="Infinity" styleClass="btn-primary" prefHeight="40"/>
                    
                    <HBox alignment="CENTER" spacing="6" style="-fx-padding: 8 0 0 0;">
                        <Label text="Default logins:" style="-fx-text-fill: #64748b; -fx-font-size: 11px;"/>
                        <Label text="passenger1 / pass123  •  admin / admin123" style="-fx-text-fill: #2563eb; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                    </HBox>
                </VBox>
            </Tab>

            <!-- TAB 2: REGISTER -->
            <Tab text="  Create Account  ">
                <VBox spacing="12">
                    <padding>
                        <Insets top="14" right="8" bottom="8" left="8"/>
                    </padding>
                    <HBox spacing="10">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Full Name:"/>
                            <TextField fx:id="regFullNameField" promptText="e.g. Amit Verma"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Username:"/>
                            <TextField fx:id="regUsernameField" promptText="Choose username"/>
                        </VBox>
                    </HBox>
                    <HBox spacing="10">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Email Address:"/>
                            <TextField fx:id="regEmailField" promptText="amit@example.com"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Password:"/>
                            <PasswordField fx:id="regPasswordField" promptText="Password"/>
                        </VBox>
                    </HBox>
                    <HBox spacing="10">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Phone Number:"/>
                            <TextField fx:id="regPhoneField" promptText="10-digit mobile"/>
                        </VBox>
                        <VBox spacing="4" prefWidth="90">
                            <Label text="Age:"/>
                            <TextField fx:id="regAgeField" promptText="e.g. 29"/>
                        </VBox>
                        <VBox spacing="4" prefWidth="120">
                            <Label text="Gender:"/>
                            <ComboBox fx:id="regGenderCombo" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>
                    <Label fx:id="regStatusLabel" wrapText="true" style="-fx-font-weight: bold;"/>
                    <Button text="Register &amp; Book Tickets" onAction="#handleRegister"
                            maxWidth="Infinity" styleClass="btn-success" prefHeight="40"/>
                </VBox>
            </Tab>
        </TabPane>
    </VBox>
</VBox>
