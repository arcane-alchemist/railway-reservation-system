<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.railway.controller.SearchController"
      spacing="16" style="-fx-background-color: #0b1120;">
    <padding>
        <Insets top="20" right="25" bottom="20" left="25"/>
    </padding>

    <!-- Top Navigation Bar -->
    <HBox alignment="CENTER_LEFT" spacing="15" styleClass="card-panel">
        <padding>
            <Insets top="12" right="20" bottom="12" left="20"/>
        </padding>
        <Button text="← Back to Dashboard" onAction="#handleBackToDashboard" styleClass="btn-secondary"/>
        <VBox HBox.hgrow="ALWAYS">
            <Label text="Search &amp; Book Trains" styleClass="section-title"/>
            <Label text="Find available trains across major Indian Railways routes" styleClass="header-subtitle"/>
        </VBox>
    </HBox>

    <!-- Search Controls Card -->
    <VBox spacing="14" styleClass="card-panel">
        <padding>
            <Insets top="16" right="20" bottom="16" left="20"/>
        </padding>

        <HBox spacing="15" alignment="BOTTOM_LEFT">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Source Station:"/>
                <ComboBox fx:id="sourceStationCombo" maxWidth="Infinity" promptText="Select origin"/>
            </VBox>

            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Destination Station:"/>
                <ComboBox fx:id="destinationStationCombo" maxWidth="Infinity" promptText="Select destination"/>
            </VBox>

            <VBox spacing="6" prefWidth="180">
                <Label text="Journey Date:"/>
                <DatePicker fx:id="travelDatePicker" maxWidth="Infinity"/>
            </VBox>

            <Button text="🔍 Search Trains" onAction="#handleSearchTrains" styleClass="btn-primary" prefHeight="38"/>
        </HBox>

        <Label fx:id="searchStatusLabel" style="-fx-font-weight: bold;"/>
    </VBox>

    <!-- Train Results Table Card -->
    <VBox spacing="12" styleClass="card-panel" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="15" right="15" bottom="15" left="15"/>
        </padding>

        <HBox alignment="CENTER_LEFT">
            <Label text="Available Train Services" styleClass="section-title" HBox.hgrow="ALWAYS"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="bookTrainButton" text="Proceed to Book Selected Train →" onAction="#handleProceedToBooking"
                    disable="true" styleClass="btn-success"/>
        </HBox>

        <TableView fx:id="trainTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="trainNumberCol" text="Train #" prefWidth="90"/>
                <TableColumn fx:id="trainNameCol" text="Train Name" prefWidth="240"/>
                <TableColumn fx:id="typeCol" text="Type" prefWidth="130"/>
                <TableColumn fx:id="departureCol" text="Departure" prefWidth="100"/>
                <TableColumn fx:id="arrivalCol" text="Arrival" prefWidth="100"/>
                <TableColumn fx:id="seatsCol" text="Available Seats" prefWidth="130"/>
                <TableColumn fx:id="fareCol" text="Base Fare (₹)" prefWidth="120"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
