<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.railway.controller.DashboardController"
      spacing="16" styleClass="app-root">
    <padding>
        <Insets top="16" right="20" bottom="16" left="20"/>
    </padding>

    <!-- Top Passenger Navigation Bar -->
    <HBox alignment="CENTER_LEFT" spacing="15" styleClass="card-panel">
        <padding>
            <Insets top="12" right="20" bottom="12" left="20"/>
        </padding>

        <Label text="🚆" style="-fx-font-size: 26px;"/>
        <VBox HBox.hgrow="ALWAYS">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="RailPlan — IRCTC Passenger Portal" styleClass="section-title"/>
                <Label text="PASSENGER" styleClass="badge-passenger"/>
            </HBox>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label fx:id="welcomeHeaderLabel" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                <Label text="•" style="-fx-text-fill: #94a3b8;"/>
                <Label text="Real-Time Seat Booking, Dynamic Fares &amp; PNR Status" styleClass="header-subtitle"/>
            </HBox>
        </VBox>

        <Button text="🔍 Search &amp; Book Trains" onAction="#handleNavigateToSearch" styleClass="btn-primary"/>
        <Button text="Sign Out" onAction="#handleLogout" styleClass="btn-secondary"/>
    </HBox>

    <Label fx:id="statusMessageLabel" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>

    <!-- Passenger Tabs -->
    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <!-- TAB 1: MY BOOKINGS -->
        <Tab text="  📜 My Bookings &amp; Tickets  ">
            <VBox spacing="14" styleClass="card-panel">
                <padding>
                    <Insets top="16" right="16" bottom="16" left="16"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <VBox HBox.hgrow="ALWAYS">
                        <Label text="Your Active &amp; Past Train Reservations" styleClass="section-title"/>
                        <Label text="Select a booking to review travel class, berth allocation, or cancel tickets with IRCTC refund calculation." styleClass="header-subtitle"/>
                    </VBox>
                    <Button fx:id="cancelBookingButton" text="❌ Cancel Selected Ticket" onAction="#handleCancelSelectedBooking"
                            disable="true" styleClass="btn-danger"/>
                </HBox>

                <TableView fx:id="bookingsTable" VBox.vgrow="ALWAYS" prefHeight="400">
                    <columns>
                        <TableColumn fx:id="pnrCol" text="PNR Reference" prefWidth="140"/>
                        <TableColumn fx:id="trainCol" text="Train Name &amp; #" prefWidth="260"/>
                        <TableColumn fx:id="travelDateCol" text="Travel Date" prefWidth="120"/>
                        <TableColumn fx:id="classCol" text="Class" prefWidth="110"/>
                        <TableColumn fx:id="fareCol" text="Total Fare (₹)" prefWidth="120"/>
                        <TableColumn fx:id="statusCol" text="Status" prefWidth="120"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <!-- TAB 2: PNR STATUS ENQUIRY -->
        <Tab text="  🔎 PNR Status Enquiry  ">
            <VBox spacing="18" styleClass="card-panel">
                <padding>
                    <Insets top="24" right="24" bottom="24" left="24"/>
                </padding>

                <Label text="Instant PNR Status Verification" styleClass="section-title"/>
                <Label text="Enter your 8-to-10 digit PNR to retrieve live confirmation status, journey route, and allocated seat." styleClass="header-subtitle"/>

                <HBox spacing="10" alignment="CENTER_LEFT" maxWidth="600">
                    <TextField fx:id="pnrSearchField" promptText="Enter PNR Number (e.g. PNR12345678)" HBox.hgrow="ALWAYS"/>
                    <Button text="Check PNR Status" onAction="#handleSearchPNR" styleClass="btn-primary"/>
                </HBox>

                <VBox spacing="8" style="-fx-background-color: #f8fafc; -fx-padding: 16; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
                    <Label text="Enquiry Result:" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                    <Label fx:id="pnrSearchResultLabel" text="Enter a PNR number above to look up ticket status."
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #64748b;" wrapText="true"/>
                </VBox>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
